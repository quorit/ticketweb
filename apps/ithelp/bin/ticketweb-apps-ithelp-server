#!/bin/bash
set -e

# Load environment (defines $DEVEL_MODE, $LOG_DIR, $BUILD_ID, etc.)
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ticketweb-apps-ithelp-setenv"

config_file="$CONFIG_DIR/app-server-config.json5"

# 1. Configuration Extraction
if ! python3 -m json5 "$config_file" > /dev/null 2>&1; then
    echo "Error: Configuration file $config_file is missing or invalid JSON5." >&2
    exit 1
fi

config_file_contents=$(python3 -m json5 --as-json "$config_file")

port_number=$(echo "$config_file_contents" | jq -r .port)


gunicorn_bind="127.0.0.1:$port_number"

# 2. Execution Logic
if [ "$DEVEL_MODE" = "true" ]; then
    echo "Starting Development Server (Reloading) on port $port_number..."
    
    # Pre-emptive Strike: Kill anything sitting on our target port
    echo "Clearing port $port_number of any lingering processes..."
    fuser -k "${port_number}/tcp" 2>/dev/null || true
    
    # Give the OS a split second to fully release the socket
    sleep 0.5

    # Because we aren't trapping anymore, we can safely use 'exec' to replace Bash 
    # directly with Gunicorn, keeping the process tree nice and clean.
    exec gunicorn --log-level debug --reload --bind "$gunicorn_bind" \
             "ticketweb_apps_ithelp.back_end.app:main()"
else
    echo "Starting Production Server..."

    # Check for Log Directory
    if [ ! -w "$LOG_DIR" ]; then
        echo "Error: Log directory $LOG_DIR does not exist or is not writable by $(whoami)." >&2
        echo "Ensure the install script was run correctly as root." >&2
        exit 1
    fi

    # The PID file location must match your systemd RuntimeDirectory
    PID_FILE="/run/ticketweb/$BUILD_ID/apps/ithelp/server.pid"

    # We use 'exec' so Gunicorn receives signals directly from systemd
    exec gunicorn --bind "$gunicorn_bind" \
         --access-logfile="$LOG_DIR/server-access.log" \
         --error-logfile="$LOG_DIR/server-error.log" \
         --pid "$PID_FILE" \
         "ticketweb_apps_ithelp.back_end.app:main()"
fi