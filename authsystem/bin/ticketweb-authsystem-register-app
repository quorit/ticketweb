#!/bin/bash

# If this is ran from a Python virtual environment,
# it should be activated
#


# Exit immediately if a command fails
set -e

# 1. Pull in the environment
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ticketweb-authsystem-setenv"

usage()
{
  echo "Usage: ticketweb-authsystem-register-app <app_name>"
  exit 2
}

# 1. Check for correct number of arguments (Fixed: -ne instead of -eq)
if [ "$#" -ne 1 ]; then
    usage
fi

app_name="$1"

# 2. Fixed path to match the installation script
apps_file="$CONFIG_DIR/applications.json"

echo "Registering application: $app_name..."

# 3. Safely update the JSON file
tmpfile=$(mktemp -t applications.json.tmp.XXXXXXXXXX)
cat "$apps_file" > "$tmpfile"

jq ".\"application_set\" |= (.+ [\"$app_name\"] | unique)" "$tmpfile" > "$apps_file"

rm "$tmpfile"

# 4. Generate the RSA Key
pem_file="$CONFIG_DIR/rsa/$app_name.pem"

echo "Generating RSA private key for $app_name..."
openssl genrsa -out "$pem_file" 2048

# Secure the private key so only the owner can read it
chmod 600 "$pem_file"

# 5. Fixed variable case and string comparison
if [ "$DEVEL_MODE" = "false" ]; then
   echo "Production mode: Securing key ownership..."
   chown ticketweb_authsystem:ticketweb_authsystem "$pem_file"
fi

echo "Application '$app_name' registered successfully!"