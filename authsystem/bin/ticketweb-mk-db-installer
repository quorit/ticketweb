#!/usr/bin/env python3
import sys
import os
from importlib.resources import files

def main():
    if len(sys.argv) != 2:
        print("Usage: ticketweb-authsystem-mk-db-schema-install <output_file_path>")
        sys.exit(2)

    out_path = sys.argv[1]
    package_name = 'ticketweb_authsystem_server'

    print(f"Generating portable installer for '{package_name}'...")

    # 1. Read the assets directly from the Python package
    try:
        sql_content = files(package_name).joinpath('session_storage_schema.sql').read_text()
        script_content = files(package_name).joinpath('ticketweb-authsystem-create-db-schema').read_text()
    except Exception as e:
        print(f"Error: Could not read package assets. Ensure the package is installed.")
        print(f"Details: {e}")
        sys.exit(1)

    # 2. Define the Self-Extracting Bash Wrapper
    # We use a simple template string to avoid Python's f-string '{}' clashing with Bash variables.
    installer_template = """#!/bin/bash
# ==============================================================================
# Portable TicketWeb Auth System Database Installer
# This is an auto-generated, self-extracting payload. 
# It requires NO Python environment or package dependencies on the target machine.
# ==============================================================================

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <db_name>"
    exit 2
fi

DB_NAME="$1"

# Create secure temporary files for the payload
TEMP_SQL=$(mktemp /tmp/tw_schema.XXXXXX.sql)
TEMP_SCRIPT=$(mktemp /tmp/tw_script.XXXXXX.sh)

# Ensure cleanup happens when the script exits, succeeds, or gets interrupted
trap "rm -f \\"$TEMP_SQL\\" \\"$TEMP_SCRIPT\\"" EXIT INT TERM

# --- 1. EXTRACT SQL SCHEMA ---
cat << 'EOF_SQL_PAYLOAD' > "$TEMP_SQL"
__SQL_CONTENT_PLACEHOLDER__
EOF_SQL_PAYLOAD

# --- 2. EXTRACT BASH SCRIPT ---
cat << 'EOF_SCRIPT_PAYLOAD' > "$TEMP_SCRIPT"
__SCRIPT_CONTENT_PLACEHOLDER__
EOF_SCRIPT_PAYLOAD

# --- 3. EXECUTE PAYLOAD ---
# Make the extracted script executable
chmod +x "$TEMP_SCRIPT"

echo "Executing self-contained schema deployment..."
# Run the script, injecting the DB Name and the temporary SQL path
"$TEMP_SCRIPT" "$DB_NAME" "$TEMP_SQL"
"""

    # 3. Inject the contents into the template
    final_script = installer_template.replace("__SQL_CONTENT_PLACEHOLDER__", sql_content)
    final_script = final_script.replace("__SCRIPT_CONTENT_PLACEHOLDER__", script_content)

    # 4. Write the output file
    try:
        with open(out_path, 'w') as f:
            f.write(final_script)
            
        # Make the generated installer executable (chmod +x)
        os.chmod(out_path, os.stat(out_path).st_mode | 0o111)
        print(f"### Success! Portable installer generated at: {out_path} ###")
    except Exception as e:
        print(f"Error writing installer: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()