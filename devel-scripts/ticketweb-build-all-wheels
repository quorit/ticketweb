#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status.
set -e

# ==============================================================================
# Pre-flight Checks
# ==============================================================================

# 1. Check for exactly one argument
if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <target_directory>"
    exit 1
fi

TARGET_DIR="$1"

# 2. Check that TICKETWEB_REPO_ROOT is set
if [ -z "$TICKETWEB_REPO_ROOT" ]; then
    echo "Error: TICKETWEB_REPO_ROOT environment variable is not set."
    exit 1
fi

# 3. Check that the target directory exists
if [ ! -d "$TARGET_DIR" ]; then
    echo "Error: Target directory '$TARGET_DIR' does not exist."
    exit 1
fi

# ==============================================================================
# Cleanup Phase: Remove old dist directories
# ==============================================================================
echo "Cleaning out old build artifacts..."

# Using rm -rf completely removes the directory so we don't accidentally
# copy old artifacts. The python build system will recreate these folders.
rm -rf "$TICKETWEB_REPO_ROOT/authsystem/dist"
rm -rf "$TICKETWEB_REPO_ROOT/applib/dist"
rm -rf "$TICKETWEB_REPO_ROOT/loginportal/dist"
rm -rf "$TICKETWEB_REPO_ROOT/apps/reporting/dist"
rm -rf "$TICKETWEB_REPO_ROOT/apps/ithelp/dist"

echo "Cleanup complete."
echo "------------------------------------------------------------"

# ==============================================================================
# Build and Copy Process
# ==============================================================================

echo "Starting full build process. Target directory: $TARGET_DIR"
echo "------------------------------------------------------------"

echo "1/5: Building Auth System..."
ticketweb-authsystem-build-wheel
echo "Copying Auth System wheel..."
cp "$TICKETWEB_REPO_ROOT/authsystem/dist/"*.whl "$TARGET_DIR/"

echo "------------------------------------------------------------"
echo "2/5: Building App Lib..."
ticketweb-applib-build-wheel
echo "Copying App Lib wheel..."
cp "$TICKETWEB_REPO_ROOT/applib/dist/"*.whl "$TARGET_DIR/"

echo "------------------------------------------------------------"
echo "3/5: Building Login Portal..."
ticketweb-loginportal-build-wheel
echo "Copying Login Portal wheel..."
cp "$TICKETWEB_REPO_ROOT/loginportal/dist/"*.whl "$TARGET_DIR/"

echo "------------------------------------------------------------"
echo "4/5: Building Reporting App..."
ticketweb-app-build-wheel reporting
echo "Copying Reporting App wheel..."
cp "$TICKETWEB_REPO_ROOT/apps/reporting/dist/"*.whl "$TARGET_DIR/"

echo "------------------------------------------------------------"
echo "5/5: Building IT Help App..."
ticketweb-app-build-wheel ithelp
echo "Copying IT Help App wheel..."
cp "$TICKETWEB_REPO_ROOT/apps/ithelp/dist/"*.whl "$TARGET_DIR/"

echo "------------------------------------------------------------"
echo "All wheels built and copied successfully to: $TARGET_DIR"