#!/bin/bash
# ticketweb-app-build-wheel [git repo root directory] <app name>

set -e # Exit on error

if [ "$EUID" -eq 0 ]; then
    echo "Error: This script must NOT be run as root."
    exit 1
fi

# 1. Determine Repository Root and App Name
if [ -n "$TICKETWEB_REPO_ROOT" ]; then
    git_repo_root="$TICKETWEB_REPO_ROOT"
    if [ "$#" -ne 1 ]; then
        echo "Usage: ticketweb-app-build-wheel <app_name>"
        echo "(Or set TICKETWEB_REPO_ROOT to omit the repo root argument)"
        exit 2
    fi
    app_name="$1"
else
    if [ "$#" -ne 2 ]; then
        echo "Usage: ticketweb-app-build-wheel <git_repo_root> <app_name>"
        echo "(Or set TICKETWEB_REPO_ROOT to omit the repo root argument)"
        exit 2
    fi
    git_repo_root="$1"
    app_name="$2"
fi

TARGET_DIR="$git_repo_root/apps/$app_name"
PACKAGE_ROOT=$(cd "$TARGET_DIR" && pwd)

echo "### Starting Build for App: $app_name ###"
echo "### Package Root: $PACKAGE_ROOT ###"

# 2. Clean old build artifacts
echo "--> Cleaning old build artifacts..."
rm -rf "$PACKAGE_ROOT/dist" "$PACKAGE_ROOT/build" "$PACKAGE_ROOT"/*.egg-info

# 3. Build the Python Wheel
echo "--> Packaging Wheel..."
python3 -m build --wheel "$PACKAGE_ROOT"

echo "### Build Successful. Wheel ready in $PACKAGE_ROOT/dist/ ###"