#!/bin/bash
echo "### This script was invoked by the following command: "
printf '%q ' "$0" "$@"
echo ""
echo "###"

# This script watches the prune sessions timer and service, and prints the logs in real time. It also starts the timer at the beginning and stops it at the end.
# Note that no virtual environment is activated in this script, so it relies on the systemd 
# service to activate the virtual environment and run the prune sessions command. 
# This is intentional, as it allows us to test the systemd service and timer without any interference from the current shell environment.

# Exit immediately if a command fails
set -e

# ==========================================
# ENVIRONMENT VALIDATION
# ==========================================

# Check that TICKETWEB_DEVEL_VENV_ROOT is defined and not empty
if [ -z "$TICKETWEB_DEVEL_VENV_ROOT" ]; then
    echo "Error: TICKETWEB_DEVEL_VENV_ROOT is not defined or is empty." >&2
    exit 1
fi

# Check that the .env file actually exists
ENV_FILE="$TICKETWEB_DEVEL_VENV_ROOT/.env"
if [ ! -f "$ENV_FILE" ]; then
    echo "Error: The environment file does not exist at $ENV_FILE" >&2
    exit 1
fi

# 1. Pull in the environment so we can have BUILD_ID
source "$ENV_FILE"

# Check that BUILD_ID was successfully defined by the source command
if [ -z "$BUILD_ID" ]; then
    echo "Error: BUILD_ID was not defined after sourcing $ENV_FILE" >&2
    exit 1
fi

# ==========================================
# EXECUTION & CLEANUP
# ==========================================

# Ensure the timer is stopped no matter how this script exits (e.g., hitting Ctrl+C)
trap 'echo -e "\nStopping timer..."; systemctl --user stop "ticketweb-authsystem-prunesessions@$BUILD_ID.timer"; echo "Timer stopped."' EXIT

echo "Starting timer for BUILD_ID: $BUILD_ID..."
systemctl --user start "ticketweb-authsystem-prunesessions@$BUILD_ID.timer"

echo "Tailing journal logs (Press Ctrl+C to stop and cleanup)..."
journalctl --user -fu "ticketweb-authsystem-prunesessions@$BUILD_ID.service"


