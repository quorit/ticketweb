#!/bin/bash

# Exit immediately if a command fails
set -e

echo "Starting TicketWeb Login Portal Build/Serve Script..."

# 1. Pull in the environment
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/ticketweb-loginportal-setenv"

# 2. Locate the frontend module
FRONTEND_MODULE_PATH=$(python -c "from importlib.resources import files; print(files('ticketweb_loginportal_server').joinpath('frontend-module'))")

if [ ! -d "$FRONTEND_MODULE_PATH" ]; then
    echo "Error: Could not locate frontend_module at $FRONTEND_MODULE_PATH"
    exit 1
fi

# Load the Frontend Config Payload
CONFIG_FILE="$CONFIG_DIR/frontend-config.json5"
if [ ! -f "$CONFIG_FILE" ]; then
    echo "Error: Frontend config file missing at $CONFIG_FILE."
    echo "Please ensure the installation script completed successfully."
    exit 1
fi

echo "Loading frontend configuration into environment..."
# Exporting this makes it available to Node/Vue during the build/serve process
export VUE_APP_CONFIG_DATA=$(python3 -m json5 --as-json "$CONFIG_FILE")




verify_npm_reqs()
{
    echo "Verifying Node.js, npm, and nvm environment..."
    echo "Verifying Node.js environment..."

    # 1. Check that node and npm exist globally or locally
    if ! command -v node >/dev/null 2>&1; then
        echo "Error: 'node' command not found. Node.js is required for this installation." >&2
        exit 1
    fi

    if ! command -v npm >/dev/null 2>&1; then
        echo "Error: 'npm' command not found. npm is required for this installation." >&2
        exit 1
    fi

    echo "Found Node.js: $(node -v)"
    echo "Found npm: $(npm -v)"

    #   Strict nvm check
    echo "Verifying nvm environment..."
    
    # Because this is a non-interactive bash script, the 'nvm' shell function 
    # itself won't be loaded into memory. The most bulletproof way to check 
    # if nvm is driving the environment is to check the path of the active node binary.
    NODE_BIN_PATH=$(which node)
    
    if [[ "$NODE_BIN_PATH" != *".nvm"* ]]; then
        echo "Error: Development installation requires Node.js to be managed by nvm." >&2
        echo "Current node executable is located at a system path: $NODE_BIN_PATH" >&2
        echo "Please ensure nvm is installed, loaded, and active in this terminal." >&2
        exit 1
    fi
    
    echo "nvm environment verified ($NODE_BIN_PATH)."
}

# ==============================================================================
# DEVELOPMENT MODE
# ==============================================================================
if [ "$DEVEL_MODE" = "true" ]; then
    echo "### DEVELOPMENT MODE ACTIVE ###"
    if [ "$#" -ne 0 ]; then
        echo "Error: In development mode, this script takes no arguments."
        exit 1
    fi

    # Extract the port from the pre-parsed JSON payload
    VUE_PORT=$(echo "$VUE_APP_CONFIG_DATA" | jq -r '.devel_port')

    if [ -z "$VUE_PORT" ] || [ "$VUE_PORT" == "null" ]; then
        echo "Error: Could not determine devel_port from frontend configuration." >&2
        exit 1
    fi

    # Load the Backend Config Payload
    BE_CONFIG_FILE="$CONFIG_DIR/server-config.json5"
    if [ ! -f "$BE_CONFIG_FILE" ]; then
        echo "Error: Server config file missing at $BE_CONFIG_FILE."
        echo "Please ensure the installation script completed successfully."
        exit 1
    fi
    echo "Loading back end configuration into environment..."
    be_config_json=$(python3 -m json5 --as-json "$BE_CONFIG_FILE")



    export VUE_APP_BE_PORT_NUMBER="$(echo "$be_config_json" | jq -r .port)"

    echo "Booting Vue development server on port $VUE_PORT with Hot Module Replacement..."

    # Set the trap to kill the orphaned Node/Webpack processes
    trap 'echo -e "\nCleaning up lingering Vue processes on port $VUE_PORT..."; fuser -k "${VUE_PORT}/tcp" 2>/dev/null || true' EXIT

    (
        verify_npm_reqs
        cd "$FRONTEND_MODULE_PATH" || exit 1
        # npm install is skipped as it was handled by the dev installer
        npm run serve
    )

# ==============================================================================
# PRODUCTION MODE
# ==============================================================================
else
    echo "### PRODUCTION MODE ACTIVE ###"
    
    # 1. Validate Arguments and Execution Context
    if [ "$1" != "--non-root-user" ] || [ -z "$2" ]; then
        echo "Usage: $0 --non-root-user <username>"
        exit 1
    fi
    
    BUILD_USER="$2"
    
    if [ "$EUID" -ne 0 ]; then
        echo "Error: Production build must be run as root to manage privileges and deploy to $SRV_DIR."
        exit 1
    fi
    
    if ! id "$BUILD_USER" &>/dev/null; then
        echo "Error: User '$BUILD_USER' does not exist."
        exit 1
    fi

    # 2. Set up the Disposable Build Environment
    TEMP_DIR=$(mktemp -d /tmp/tw-loginportal-build.XXXXXX)
    echo "Created secure temporary build directory at $TEMP_DIR"
    
    # Ensure cleanup happens no matter how the script exits
    trap 'echo "Cleaning up temporary build directory..."; rm -rf "$TEMP_DIR"' EXIT INT TERM

    echo "Copying frontend assets to sandbox..."
    cp -r "$FRONTEND_MODULE_PATH" "$TEMP_DIR/"
    
    # Transfer ownership of the copied files to the designated build user
    chown -R "$BUILD_USER":"$BUILD_USER" "$TEMP_DIR"

    # 3. The Restricted Build Execution
    echo "Dropping privileges to user '$BUILD_USER' to safely compile Node assets..."
    
    # -H ensures $HOME points to the BUILD_USER's home directory.
    # We removed -E so root's environment doesn't pollute the build user's paths.
    sudo -H -u "$BUILD_USER" TEMP_DIR="$TEMP_DIR" VUE_APP_CONFIG_DATA="$VUE_APP_CONFIG_DATA" bash -c '
        
        # ---------------------------------------------------------
        # MANUALLY INITIALIZE NVM FOR THIS NON-INTERACTIVE SHELL
        # ---------------------------------------------------------
        export NVM_DIR="$HOME/.nvm"
        if [ -s "$NVM_DIR/nvm.sh" ]; then
            \. "$NVM_DIR/nvm.sh"
        else
            echo "Error: nvm.sh not found in $NVM_DIR." >&2
            echo "Please ensure nvm is installed for user $USER." >&2
            exit 1
        fi
        
        verify_npm_reqs()
        {
            echo "Verifying Node.js, npm, and nvm environment..."

            # 1. Check that node and npm exist
            if ! command -v node >/dev/null 2>&1; then
                echo "Error: '\''node'\'' command not found. Node.js is required." >&2
                exit 1
            fi

            if ! command -v npm >/dev/null 2>&1; then
                echo "Error: '\''npm'\'' command not found. npm is required." >&2
                exit 1
            fi

            echo "Found Node.js: $(node -v)"
            echo "Found npm: $(npm -v)"

            # Strict nvm check
            echo "Verifying nvm environment..."
            NODE_BIN_PATH=$(which node)
    
            if [[ "$NODE_BIN_PATH" != *".nvm"* ]]; then
                echo "Error: Production build requires Node.js to be managed by nvm." >&2
                echo "Current node executable is located at a system path: $NODE_BIN_PATH" >&2
                exit 1
            fi
    
            echo "nvm environment verified ($NODE_BIN_PATH)."
        }
        
        verify_npm_reqs
        
        # TEMP_DIR is safely read from the environment
        cd "$TEMP_DIR/frontend-module" || exit 1
        
        echo "Running npm install..."
        npm install
        
        echo "Running npm run build..."
        npm run build
    '
    
    # 4. Return to Root & Deploy
    echo "Build complete. Resuming root privileges for deployment..."
    
    DIST_DIR="$TEMP_DIR/frontend-module/dist"
    if [ ! -d "$DIST_DIR" ]; then
        echo "Error: Build failed. 'dist' directory was not generated."
        exit 1
    fi

    echo "Deploying compiled assets to $SRV_DIR..."
    # Clear out the old version
    rm -rf "${SRV_DIR:?}/"*
    # Move the new version in
    cp -r "$DIST_DIR/"* "$SRV_DIR/"
    
    # Secure the deployed assets (Standard web-readable permissions)
    chown -R root:root "$SRV_DIR"
    find "$SRV_DIR" -type d -exec chmod 755 {} \;
    find "$SRV_DIR" -type f -exec chmod 644 {} \;

    echo "### Production Deployment Successful! ###"
fi