{

   // In devel mode,
   // vue_app_path_root should just be
   // set to "/" 
   // In production mode,
   // vue_app_path_root might like like this:
   // "/ticketweb/loginportal/"
   //
   // The example path in production mode has the "loginportal"
   // segment because the production front end web server (probably Apache)
   // has to differentiate between multiple front ends for the different apps, and it does this by having a segment in the URL path for each app.
   // For instance "/ticketweb/apps/reporting" would point to another front end
   // (i.e. that of the reporting app front end),
   // whereas a development server only serves it's own front end.
   "vue_app_path_root": "/",
   "banner": {
       "mode_text": "(development build)",
       "color": "red"
   },

   // "devel_port" is used only in development mode, and is ignored in production mode. 
   // In production mode, you should probably delete this section or comment it out, to avoid any confusion.
   // This is the port that the development server (i.e. the one started by "npm run serve") listens on.
   "devel_port": "8082"
}

