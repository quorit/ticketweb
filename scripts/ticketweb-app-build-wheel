#!/bin/bash
# ticketweb-app-build-wheel <directory>

if [ "$EUID" -eq 0 ]; then
    echo "Error: This script must NOT be run as root."
    exit 1
fi

# ==============================================================================
# Verify Node.js, npm, and nvm requirements
# ==============================================================================

echo "Development mode detected. Verifying Node.js, npm, and nvm environment..."
echo "Verifying Node.js environment..."

# 1. Check that node and npm exist globally or locally
if ! command -v node >/dev/null 2>&1; then
    echo "Error: 'node' command not found. Node.js is required for this installation." >&2
    exit 1
fi

if ! command -v npm >/dev/null 2>&1; then
    echo "Error: 'npm' command not found. npm is required for this installation." >&2
    exit 1
fi

echo "Found Node.js: $(node -v)"
echo "Found npm: $(npm -v)"

#   Strict nvm check
echo "Verifying nvm environment..."
    
# Because this is a non-interactive bash script, the 'nvm' shell function 
# itself won't be loaded into memory. The most bulletproof way to check 
# if nvm is driving the environment is to check the path of the active node binary.
NODE_BIN_PATH=$(which node)
    
if [[ "$NODE_BIN_PATH" != *".nvm"* ]]; then
    echo "Error: Wheel build requires Node.js to be managed by nvm." >&2
    echo "Current node executable is located at a system path: $NODE_BIN_PATH" >&2
    echo "Please ensure nvm is installed, loaded, and active in this terminal." >&2
    exit 1
fi
    
echo "nvm environment verified ($NODE_BIN_PATH)."

# ==============================================================================



TARGET_DIR=${1:-"."}
PACKAGE_ROOT=$(cd "$TARGET_DIR" && pwd)
FE_DIR="$PACKAGE_ROOT/src/frontend_module" # Adjusted for your src/ layout

# Library Source Paths
AUTH_LIB_SRC="$(cd "$PACKAGE_ROOT/../ticketweb-authsystem/src/frontend_module" && pwd)"
RT_LIB_SRC="$(cd "$PACKAGE_ROOT/../ticketweb-rt-interface/src/frontend_module" && pwd)"

echo "### Starting Safe Build: $PACKAGE_ROOT ###"

# 1. Protect the Development State
if [ -d "$FE_DIR" ]; then
    echo "--> Shelving development node_modules..."
    [ -d "$FE_DIR/node_modules" ] && mv "$FE_DIR/node_modules" "$FE_DIR/node_modules_dev_bak"
    [ -f "$FE_DIR/package-lock.json" ] && cp "$FE_DIR/package-lock.json" "$FE_DIR/package-lock.json.dev_bak"
    
    # 2. Production-Style Install (for the Wheel)
    echo "--> Resolving Monorepo dependencies for Wheel..."
    (
        cd "$FE_DIR" || exit 1
        npm install
        npm install "$AUTH_LIB_SRC"
        npm install "$RT_LIB_SRC"
    )
fi

# 3. Build the Python Wheel
echo "--> Packaging Wheel..."
rm -rf "$PACKAGE_ROOT/dist" "$PACKAGE_ROOT/build"
python3 -m build --wheel
BUILD_STATUS=$?

# 4. Restore Development State
if [ -d "$FE_DIR" ]; then
    echo "--> Restoring development symlinks..."
    rm -rf "$FE_DIR/node_modules"
    [ -d "$FE_DIR/node_modules_dev_bak" ] && mv "$FE_DIR/node_modules_dev_bak" "$FE_DIR/node_modules"
    [ -f "$FE_DIR/package-lock.json.dev_bak" ] && mv "$FE_DIR/package-lock.json.dev_bak" "$FE_DIR/package-lock.json"
fi

if [ $BUILD_STATUS -eq 0 ]; then
    echo "### Build Successful. Monorepo integrity maintained. ###"
else
    echo "Error: Build failed. Check the logs above."
    exit 1
fi